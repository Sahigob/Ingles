rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuario solo puede leer y modificar su propio progreso.
    match /users/{userId}/private/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Cada usuario solo puede leer y guardar sus propios resultados de examen.
    match /users/{userId}/examResults/{examId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Cualquier otra ruta queda cerrada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
