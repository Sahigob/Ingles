
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Lista de usuarios autorizados.
    // Los documentos se crearán manualmente desde Firebase.
    match /authorizedUsers/{userId} {
      allow read: if request.auth != null
                  && request.auth.uid == userId;

      allow create, update, delete: if false;
    }

    // Progreso privado de cada usuario autorizado.
    match /users/{userId}/private/{document=**} {
      allow read, write:
        if request.auth != null
        && request.auth.uid == userId
        && exists(
          /databases/$(database)/documents/authorizedUsers/$(request.auth.uid)
        );
    }

    // Resultados de exámenes.
    match /users/{userId}/examResults/{examId} {
      allow read, write:
        if request.auth != null
        && request.auth.uid == userId
        && exists(
          /databases/$(database)/documents/authorizedUsers/$(request.auth.uid)
        );
    }

    // Denegar cualquier otro acceso.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
